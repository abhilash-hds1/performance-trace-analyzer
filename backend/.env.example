# Copy to .env and fill in real values. Never commit .env.

# HTTP
PORT=8787
HOST=127.0.0.1

# CORS: comma-separated list of allowed origins. Extension origins look like
# chrome-extension://<extension-id>. For local dev you can use a wildcard
# string "chrome-extension://*" which is matched as a glob.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://*

# OpenAI
# Required for real analysis; if missing, /analyze returns a deterministic stub.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ingest limits
MAX_TRACE_BYTES=26214400
TRACE_TTL_MS=1800000

# GitHub — optional fine-grained PAT for private repos / higher API limits when correlating traces to repo files
GITHUB_TOKEN=
# OAuth placeholders for future full flow
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
